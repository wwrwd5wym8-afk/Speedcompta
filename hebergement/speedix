#!/usr/bin/env bash
# Speedix – commandes d'administration du serveur
D=/opt/speedix; . $D/speedix.conf 2>/dev/null || true
case "${1:-etat}" in
  etat) echo "Speedix sur https://$DOMAINE (mode $MODE) · version $(cat $D/app/version.txt 2>/dev/null)"; docker ps --format '  {{.Names}} : {{.Status}}'; echo; ufw status | head -12; echo; fail2ban-client status | tail -2; echo; ls -lht /var/backups/speedix | head -5;;
  sauvegarde) $D/bin/sauvegarde.sh;;
  restaurer) shift; $D/bin/restaurer.sh "$@";;
  maj) $D/bin/maj.sh; echo "À jour : version $(cat $D/app/version.txt)";;
  redemarrer) cd $D && docker compose restart; [ -d $D/supabase ] && (cd $D/supabase && docker compose restart);;
  journal) tail -n 50 $D/logs/access.log | jq -r '"\(.ts|todate) \(.request.remote_ip) \(.status) \(.request.method) \(.request.uri)"' 2>/dev/null || tail -n 50 $D/logs/access.log;;
  bannis) fail2ban-client status speedix-web; fail2ban-client status sshd;;
  debannir) fail2ban-client unban "$2";;
  editeur) [ -n "${2:-}" ] || { echo "Usage : speedix editeur email@domaine.fr"; exit 1; }; docker exec -i supabase-db psql -U postgres -d postgres -c "insert into public.sc_editors(user_id, email) select id, email from auth.users where lower(email)=lower('$2') on conflict do nothing;" && echo "$2 est éditeur (après création de son compte dans Speedix).";;
  *) echo "Usage : speedix etat | sauvegarde | restaurer <fichier> | maj | redemarrer | journal | bannis | debannir <ip> | editeur <email>";;
esac
